# THERMAL // INTELLIGENCE
# Copy to .env (repo root) and/or backend/.env and frontend/.env.local

# --- Runtime mode ---
# demo | live
# If FIRMS_MAP_KEY is missing, the backend always falls back to DEMO REPLAY MODE.
APP_MODE=demo

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Used to bind review write operations. Change in any shared deployment.
ANALYST_WRITE_TOKEN=dev-review-token

# SQLite is the default so the prototype runs with no database server.
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://thermal:thermal@localhost:5432/thermal_intelligence
DATABASE_URL=sqlite:///./data/local/thermal.db

# --- NASA FIRMS (optional) ---
# Map key from https://firms.modaps.eosdis.nasa.gov/api/area/
# Never expose this to the browser.
FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_SNPP_NRT
FIRMS_DAYS=5
FIRMS_BBOX=68.0,8.0,97.5,37.5
# Historical Area API backfill is opt-in (not used on live NRT reload).
# Archived NRT (not SP): /api/area/csv/{key}/{SOURCE}/{bbox}/{1-5}/{YYYY-MM-DD}
# Dates are clipped to /api/data_availability for that product. Do not assume
# VIIRS_SNPP_SP covers the current NRT archive window.
FIRMS_HISTORICAL_SOURCE=VIIRS_SNPP_NRT
FIRMS_HISTORICAL_DAYS=30
FIRMS_HISTORICAL_BBOX=69.80,22.30,70.00,22.45

# --- Clustering (thermal source clusters, not persistence or events) ---
CLUSTER_SPATIAL_RADIUS_M=1000
CLUSTER_TEMPORAL_GAP_HOURS=48

# --- OSM / Overpass (optional) ---
OVERPASS_URL=https://overpass-api.de/api/interpreter
CONTEXT_CACHE_TTL_SECONDS=3600
OVERPASS_TIMEOUT_SECONDS=25
OVERPASS_BATCH_SIZE=12
OVERPASS_INTER_BATCH_SLEEP_S=8
OSM_VALIDATION_CLUSTER_LIMIT=10

# --- Optional satellite context tiles (never required) ---
SATELLITE_TILE_URL=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Map raster tiles (no key required). Do not put FIRMS keys here.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
